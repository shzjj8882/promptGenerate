# Docker Compose 环境变量示例
# 复制此文件为 .env 并修改相应配置

# ============================================
# 数据库配置（容器内使用服务名 postgres/redis，此处仅端口/凭据）
# ============================================
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prompthub_db

# 宿主机映射端口；若本机 6379 已被占用，可改为 6380 等（容器内仍为 6379，service 无需改 REDIS_PORT）
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# 对外暴露端口（Nginx 映射）
APP_PORT=3000

# ============================================
# 应用配置
# ============================================
# ENV=development 允许使用默认 SECRET_KEY，便于快速启动
# 生产部署请改为 ENV=production 并设置强随机 SECRET_KEY
DEBUG=False
ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# 首次创建 admin 时必须设置（≥6 位），已存在 admin 则不输出任何内容
# 忘记密码可运行: docker compose run --rm --entrypoint "" service python scripts/reset_admin_password.py 新密码
INITIAL_ADMIN_PASSWORD=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS 配置（多个域名用逗号分隔）
# 如果前端配置了域名，需要将域名添加到此处
# 例如：CORS_ORIGINS=http://localhost:3000,https://ada.championsea.online
CORS_ORIGINS=http://localhost:3000,https://ada.championsea.online

# DeepSeek API（可选：不填可启动，LLM 功能需配置；BASE/MODEL 有默认值，一般不需改）
DEEPSEEK_API_KEY=

# API Key（可选）
API_KEY=

# ============================================
# 前端配置
# ============================================
# Docker Nginx 模式：留空，使用相对路径（通过 Nginx 代理）
# 如果需要直接访问后端（不使用 Nginx），设置为：http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=
